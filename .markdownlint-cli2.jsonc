// Markdown hygiene for the repo. Prose is written one paragraph per line,
// so no length limit. Italic as underscore, bold as asterisks, matching the
// conventions noted in CLAUDE.md.
{
  "config": {
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD049": { "style": "underscore" },
    "MD050": { "style": "asterisk" }
  },
  "globs": ["**/*.md"],
  "ignores": ["node_modules/**"]
}
